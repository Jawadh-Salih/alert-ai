# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Channels to monitor (comma-separated Slack channel IDs)
ALERT_CHANNEL_IDS=C0123456789

# GCP
GCP_PROJECT_ID=your-gcp-project-id
# Optional: path to service account key (uses ADC if not set)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key

# How far back to search GCP logs (minutes)
LOG_LOOKBACK_MINUTES=30

# Log severity filter (minimum severity to fetch)
LOG_MIN_SEVERITY=ERROR
